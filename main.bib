@article{michel_lapprentissage_2008,
	location = {Dijon},
	title = {L’apprentissage du soudage de membranes armées par les pisciniers},
	volume = {N° 2},
	url = {https://shs.cairn.info/revue-travail-et-apprentissages-2008-2-page-93?lang=fr},
	doi = {10.3917/ta.002.0093},
	abstract = {Ce texte porte sur, d’une part l’analyse de l’activité de soudage de membranes armées chez les pisciniers (constructeurs et réparateurs de piscines), et d’autre part l’analyse du processus d’apprentissage de cette activité, à l’éclairage de la didactique professionnelle. Il s’agit ici d’une compétence demandant une coordination sensorimotrice fine que peu d’apprenants (15 \%) parviennent à acquérir. Ces deux niveaux d’analyse nous ont permis d’identifier la structure conceptuelle de cette activité et d’en décrire le schème sensorimoteur. Les étapes de construction des compétences (passage du concept de collage au concept de soudage, préalables au soudage, soudage avec exigence d’étanchéité puis d’esthétique) que nous avons pu faire émerger de nos analyses de l’apprentissage ont été indispensables pour la transposition didactique (par découpage, découplage et focalisation) qui nous a permis de proposer des situations facilitant cet apprentissage complexe.},
	pages = {93--110},
	number = {2},
	journaltitle = {Travail et Apprentissages},
	shortjournal = {Travail et Apprentissages},
	publisher = {Éditions Raison et Passions},
	author = {Michel, Georges and Berry-Deschamps, Pascaline},
	date = {2008},
	langid = {french},
}

